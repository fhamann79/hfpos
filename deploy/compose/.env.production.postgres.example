# Optional overlay contract ONLY. Copy outside Git; no secret/default credentials.
# Always include .env.production values as well. Do not use this file to start services.
HFPOS_PG_IMAGE=
# Root strictly below /srv/hf-one or /var/lib/hf-one, then instance/storage components.
# Components: lowercase letters/digits with single internal hyphens; no defaults.
# PG_DATA_PATH must be a dedicated strict child leaf; realpath/ownership preflight R4.
HFPOS_PG_STORAGE_ROOT=
HFPOS_PG_DATA_PATH=
HFPOS_PG_ADMIN_USER=
HFPOS_PG_DATABASE=
HFPOS_PG_ADMIN_PASSWORD_FILE=
HFPOS_MIGRATION_DATABASE_CONNECTION=
