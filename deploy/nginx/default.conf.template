server {
    listen 8080;
    server_name _;
    return 308 https://$host:${HFPOS_HTTPS_PORT}$request_uri;
}
server {
    listen 8443 ssl;
    server_name _;
    ssl_certificate /etc/nginx/tls/certificate.pem;
    ssl_certificate_key /etc/nginx/tls/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /usr/share/nginx/html;
    client_max_body_size 3m;
    index index.html;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location ~* ^/(api|health)(/|$) {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $api_authorization;
        proxy_set_header Connection "";
        proxy_cache off;
        proxy_buffering off;
    }
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
    }
    location ~* "^/.+-[A-Za-z0-9_-]{8,}\.(js|css|woff2?)$" {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
    }
    location ~* \.(js|css|json|map|ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|txt|webmanifest)$ {
        try_files $uri =404;
    }
    location / { try_files $uri $uri/ /index.html; }
}
