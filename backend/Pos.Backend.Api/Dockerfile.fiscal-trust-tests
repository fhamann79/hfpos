# Test-only image, never referenced by the release publisher. No synthetic roots in the API image.
FROM mcr.microsoft.com/dotnet/sdk:8.0-bookworm-slim@sha256:78235e09001f52b6592c458ac010775ebac6725422e80cd0c1650590f67b2743
WORKDIR /src
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_CLI_HOME=/tmp
COPY backend/Pos.Backend.Api/ ./
RUN dotnet build Pos.Backend.Api.Tests/Pos.Backend.Api.Tests.csproj -c Release -o /tests
ENTRYPOINT ["dotnet", "vstest", "/tests/Pos.Backend.Api.Tests.dll", "--TestCaseFilter:FullyQualifiedName~Pos.Backend.Api.Tests.Unit.FiscalTrustTests"]
