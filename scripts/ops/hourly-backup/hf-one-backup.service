[Unit]
Description=HF One encrypted auto-v2 online backup (human configured)
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/hf-one-hourly-backup-v2/hourly-backup/backup.py --config /etc/hf-one-backup.json
TimeoutStartSec=20min
KillMode=control-group
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
